/*
  Cache-Control: no-cache

# Assets are versioned with ?v=N in the shells (the URL changes on every deploy),
# so they are safe to cache immutably; a new deploy busts the cache via the bump.
/*.js
  Cache-Control: public, max-age=31536000, immutable

# The service worker must revalidate every load: it controls what gets cached, so
# it can never be frozen. On Pages the LAST matching rule wins, so this must sit
# BELOW the /*.js immutable rule to override it.
/sw.js
  Cache-Control: no-cache

/*.css
  Cache-Control: public, max-age=31536000, immutable

/skill.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300
